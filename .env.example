# Synthetic data provider (OpenAI-compatible Chat Completions endpoint)
# OpenRouter example: https://openrouter.ai/api/v1
LAYA_LAB_LLM_BASE_URL=https://openrouter.ai/api/v1
LAYA_LAB_LLM_API_KEY=
LAYA_LAB_SPECIALIZATION_MODEL=

# Optional independent benchmark generator. Leave blank to reuse the provider above.
LAYA_LAB_BENCHMARK_BASE_URL=
LAYA_LAB_BENCHMARK_API_KEY=
LAYA_LAB_BENCHMARK_MODEL=

# Laya runtime
LAYA_LAB_BACKEND=pytorch
LAYA_LAB_MODEL=convaiinnovations/laya
LAYA_LAB_DEVICE=
LAYA_LAB_HOME=./experiments
